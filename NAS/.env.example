# Copy this file to /etc/nas/nas-ui.env (referenced by nas-ui.service
# EnvironmentFile=) or export the variables however you prefer.
# NEVER commit the real file — keep only this example in git.
# Permissions: chmod 600 /etc/nas/nas-ui.env

# --- Web UI login (admin account) ---
NAS_USER=dev
NAS_PASSWORD=change_me_strong_password

# --- Flask session signing key ---
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app generates a random key at startup (users get logged out
# on every restart) and prints a warning.
SECRET_KEY=change_me_generated_via_secrets_token_hex

# --- ServiceNow integration (optional) ---
# SN_PASS left as the sentinel 'dummy_password' puts servicenow.py in mock mode
# (no external calls, events printed to stdout instead).
SN_INSTANCE=your-instance.service-now.com
SN_USER=your_integration_user
SN_PASS=dummy_password
# TLS certificate verification (1 = on, default; 0 only for dev instances
# with self-signed certificates)
SN_TLS_VERIFY=1
